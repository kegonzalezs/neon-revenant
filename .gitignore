# Dependencias y builds (se regeneran con npm install / npm run dist)
node_modules/
dist/
out/
build/

# Capturas y artefactos de las pruebas de desarrollo
shots/
*-smoke.png
window-open.png
live-01.png
smoke-log.txt
*.log

# Capturas de revision que las utilidades de desarrollo escriben en la raiz
# (main.cjs --smoke-test y herramientas de QC). Solo la raiz: los assets
# reales viven en assets/, art/ y docs/.
/*.png

# Pack fuente de piezas Kenney: solo lo usan los scripts de Python para
# generar los assets optimizados de assets/worlds/. Se descarga aparte.
kenney_src/

# Lanzador local: contiene una ruta absoluta a la instalacion de WorkBuddy.
# Para clonar el proyecto se usa "npm start".
JUGAR.cmd

# Configuracion local y secretos
.env
.env.*
!.env.example
.workbuddy-ai/

# Sistema operativo y editores
Thumbs.db
.DS_Store
